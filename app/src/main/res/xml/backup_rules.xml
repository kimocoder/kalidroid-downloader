<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. allowBackup="false" already turns backups off; this spells out the
     same for anything that reads the rules (see data_extraction_rules.xml for why). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
